# Database Connection
# Connection string for Prisma to connect to your PostgreSQL database.
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/postgres"

# Authentication
# Secret key used for signing JSON Web Tokens. Use a long, random string in production.
JWT_SECRET="your_super_secret_jwt_key_here"

# Google OAuth (backend only — never expose the client secret in the frontend)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Exact frontend origin allowed by CORS and used after OAuth completes
FRONTEND_URL="http://localhost:3000"

# MCP: use the numeric ID of your own existing Second Brain account.
# Required for stdio; HTTP stays disabled until MCP_ENABLED=true.
MCP_OWNER_USER_ID=""
MCP_ENABLED=false
# Private HTTP only: generate a separate random key of at least 32 characters.
MCP_API_KEY=""
# Comma-separated exact origins. Empty rejects all requests with an Origin header.
MCP_ALLOWED_ORIGINS=""
# Comma-separated allowed hostnames for /mcp; set your API hostname when hosting.
MCP_ALLOWED_HOSTS="localhost,127.0.0.1"
