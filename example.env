# Database Connection
# Connection string for Prisma to connect to your PostgreSQL database.
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/postgres"

# Authentication
# Secret key used for signing JSON Web Tokens. Use a long, random string in production.
JWT_SECRET="your_super_secret_jwt_key_here"

# Google OAuth (backend only — never expose the client secret in the frontend)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Exact frontend origin allowed by CORS and used after OAuth completes
FRONTEND_URL="http://localhost:3000"
