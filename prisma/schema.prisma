generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notes     Note[]
  shareLink ShareLink?
}

model Note {
  id             String     @id @default(uuid()) @db.Uuid
  sourceType     SourceType
  title          String
  link           String?
  content        String?
  description    String?
  thumbnail      String?
  authorName     String?
  metadata       Json?
  userId         Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  trashedAt      DateTime?
  isPublic       Boolean    @default(false)
  extractedTitle String?
  isFavorite     Boolean    @default(false)
  user           User       @relation(fields: [userId], references: [id])
  tags           Tag[]      @relation("NoteToTag")

  @@index([sourceType])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([title])
}

model Tag {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note[]   @relation("NoteToTag")
}

model ShareLink {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
}

enum SourceType {
  YOUTUBE
  TWITTER
  NOTION
  GOOGLE_DOC
  WEBSITE
  INTERNAL
}
